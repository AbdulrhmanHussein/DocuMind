# Application
APP_NAME=DocuMind
APP_ENV=development

# MongoDB
MONGODB_URI=mongodb://admin:example_password@localhost:27017/?authSource=admin
MONGODB_DATABASE=documind

# Docker MongoDB initialization
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=example_password

# Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=documind_chunks

# Cohere provider
LLM_PROVIDER=cohere
COHERE_API_KEY=your_cohere_trial_api_key
COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0
COHERE_GENERATION_MODEL=command-a-plus-05-2026

# Document processing
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=data/uploads

# Retrieval and generation
RETRIEVAL_TOP_K=5
GENERATION_MAX_OUTPUT_TOKENS=800
GENERATION_TEMPERATURE=0.1
RETRIEVAL_MAX_DISTANCE=0.65
